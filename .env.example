# AegisMCP environment configuration.
#
# Copy to .env and fill in real values. NEVER commit a .env file containing
# real secrets — .env is gitignored, but treat every value here as a secret.

# --- Server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --- Persistence -------------------------------------------------------------
# Enables PostgreSQL persistence, DB-backed policies, audit, and approvals.
# Without it the gateway runs in-memory, stateless, and REQUIRE_APPROVAL fails
# closed (no approval store => nothing can execute).
DATABASE_URL=postgres://aegis:aegis@127.0.0.1:5432/aegis

# --- Authentication ----------------------------------------------------------
# true  = enforce agent credentials (requires DATABASE_URL; refuses to start otherwise)
# false = UNAUTHENTICATED DEVELOPMENT/COMPATIBILITY MODE. Never use in production.
AUTH_REQUIRED=true

# Optional server-side pepper mixed into scrypt hashing. IMMUTABLE once set:
# changing it invalidates every existing credential. Leave empty for local dev.
CREDENTIAL_PEPPER=

# --- Upstream MCP ------------------------------------------------------------
UPSTREAM_URL=http://127.0.0.1:3001/mcp
UPSTREAM_TIMEOUT_MS=30000

# --- Trusted identity (development only) ------------------------------------
# With AUTH_REQUIRED=true the authenticated credential supplies the agent
# identity; these values identify the gateway's own server registration.
SERVER_ID=aegis-mock-mcp-server
SERVER_NAME=aegis-mock-mcp-server
AGENT_ID=default-agent
AGENT_NAME=default-agent
# Least privilege: ADMIN | OPERATOR | AUDITOR | AGENT
AGENT_ROLE=AGENT

# --- Approvals ---------------------------------------------------------------
APPROVAL_TTL_MS=900000
APPROVAL_MAX_TTL_MS=86400000
# Operator identity recorded by the operations CLI as the approver.
OPERATOR_ID=cli-operator

# --- Risk engine -------------------------------------------------------------
# true = enabled (can only strengthen policy decisions). false = disabled.
RISK_ENGINE=true

# --- Limits ------------------------------------------------------------------
MAX_REQUEST_BODY_BYTES=1048576
MAX_TOOL_ARGUMENT_BYTES=262144
